{
    "name": "wbcomdesigns/shortcodes-for-buddypress",
    "description": "Shortcodes and Elementor widgets for BuddyPress activity, members and groups.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2.0",
        "squizlabs/php_codesniffer": "^3.7",
        "wp-coding-standards/wpcs": "^3.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpstan/phpstan": "^2.1",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "arts/elementor-stubs": "^4.1"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "find . -name '*.php' -not -path './vendor/*' -not -path './node_modules/*' -print0 | xargs -0 -n1 php -l",
        "cs": "phpcs",
        "cbf": "phpcbf",
        "stan": "phpstan analyse --memory-limit=2G",
        "test": "phpunit",
        "ci": "@lint && @cs && @stan && @test"
    }
}
